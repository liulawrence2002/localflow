{
  // The app: the settings window, the overlay and their tests. The SDK package is a separate
  // project (tsconfig.sdk.json) read through its declarations. Build everything with `tsc -b`.
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@localflow/sdk": ["packages/localflow-sdk/src/index.ts"],
      "@localflow/sdk/react": ["packages/localflow-sdk/src/react.ts"],
      "@localflow/sdk/adapters/tauri": ["packages/localflow-sdk/src/adapters/tauri.ts"]
    },
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests"],
  "references": [{ "path": "./tsconfig.sdk.json" }, { "path": "./tsconfig.node.json" }]
}
