{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalFlow",
  "version": "0.1.0",
  "identifier": "app.localflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalFlow",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "LocalFlow Voice",
        "url": "index.html?view=overlay",
        "width": 593,
        "height": 91,
        "minWidth": 593,
        "minHeight": 91,
        "maxWidth": 593,
        "maxHeight": 91,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://127.0.0.1:11434",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.localflow-runtime/whisper/Release/whisper-cli.exe": "localflow-runtime/whisper/Release/whisper-cli.exe",
      "../.localflow-runtime/whisper/Release/whisper-server.exe": "localflow-runtime/whisper/Release/whisper-server.exe",
      "../.localflow-runtime/whisper/Release/*.dll": "localflow-runtime/whisper/Release/",
      "../.localflow-runtime/models/ggml-tiny.en-q5_1.bin": "localflow-runtime/models/ggml-tiny.en-q5_1.bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
