{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalFlow",
  "version": "../package.json",
  "identifier": "app.localflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalFlow",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "LocalFlow Voice",
        "url": "index.html?view=overlay",
        "width": 593,
        "height": 91,
        "minWidth": 593,
        "minHeight": 91,
        "maxWidth": 593,
        "maxHeight": 91,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://127.0.0.1:11434",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LocalFlow contributors",
    "copyright": "Copyright (c) LocalFlow contributors. Licensed under MIT OR Apache-2.0.",
    "homepage": "https://github.com/liulawrence2002/localflow",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "LICENSE.txt",
    "category": "Productivity",
    "shortDescription": "Local-first voice dictation, conversation and reading aloud for Windows",
    "longDescription": "LocalFlow is a Windows tray app for talking to your computer. Dictate into any text field, hold a hands-free spoken conversation with a language model running in Ollama on this computer, and have the focused window read aloud. Speech recognition, the language model and the voices run locally: there is no account, telemetry or cloud service, and LocalFlow never checks for updates.",
    "resources": {
      "../.localflow-runtime/whisper/Release/whisper-cli.exe": "localflow-runtime/whisper/Release/whisper-cli.exe",
      "../.localflow-runtime/whisper/Release/whisper-server.exe": "localflow-runtime/whisper/Release/whisper-server.exe",
      "../.localflow-runtime/whisper/Release/whisper.dll": "localflow-runtime/whisper/Release/whisper.dll",
      "../.localflow-runtime/whisper/Release/ggml.dll": "localflow-runtime/whisper/Release/ggml.dll",
      "../.localflow-runtime/whisper/Release/ggml-base.dll": "localflow-runtime/whisper/Release/ggml-base.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-alderlake.dll": "localflow-runtime/whisper/Release/ggml-cpu-alderlake.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-cannonlake.dll": "localflow-runtime/whisper/Release/ggml-cpu-cannonlake.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-cascadelake.dll": "localflow-runtime/whisper/Release/ggml-cpu-cascadelake.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-haswell.dll": "localflow-runtime/whisper/Release/ggml-cpu-haswell.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-icelake.dll": "localflow-runtime/whisper/Release/ggml-cpu-icelake.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-sandybridge.dll": "localflow-runtime/whisper/Release/ggml-cpu-sandybridge.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-skylakex.dll": "localflow-runtime/whisper/Release/ggml-cpu-skylakex.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-sse42.dll": "localflow-runtime/whisper/Release/ggml-cpu-sse42.dll",
      "../.localflow-runtime/whisper/Release/ggml-cpu-x64.dll": "localflow-runtime/whisper/Release/ggml-cpu-x64.dll",
      "../.localflow-runtime/models/ggml-tiny.en-q5_1.bin": "localflow-runtime/models/ggml-tiny.en-q5_1.bin",
      "LICENSE.txt": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../scripts/Get-AsrModel.ps1": "scripts/Get-AsrModel.ps1",
      "../scripts/Get-PhononModel.ps1": "scripts/Get-PhononModel.ps1",
      "../scripts/Get-VadModel.ps1": "scripts/Get-VadModel.ps1",
      "../scripts/Get-SmartTurnModel.ps1": "scripts/Get-SmartTurnModel.ps1",
      "../scripts/Get-FishModel.ps1": "scripts/Get-FishModel.ps1",
      "../scripts/Build-FishS2.ps1": "scripts/Build-FishS2.ps1",
      "../scripts/Get-WhisperRuntime.ps1": "scripts/Get-WhisperRuntime.ps1",
      "../scripts/Check-Ollama.ps1": "scripts/Check-Ollama.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
