{
  "name": "localflow",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Windows voice app: dictation, hands-free conversation and reading aloud, with speech recognition and language models running on this computer.",
  "license": "MIT OR Apache-2.0",
  "author": "LocalFlow contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/liulawrence2002/localflow"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/Start-LocalFlow.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:gpu": "tauri dev --features gpu-vulkan",
    "tauri:build:gpu": "tauri build --features gpu-vulkan",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css,json,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts,js,md}\" \"docs/**/*.md\" \".github/**/*.{yml,md}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css,json,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts,js,md}\" \"docs/**/*.md\" \".github/**/*.{yml,md}\"",
    "check": "npm run format && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
